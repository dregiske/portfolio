[
  {
    "id": "deploy-portfolio",
    "execute-command": "/bin/bash",
    "command-working-directory": "/root/portfolio",
    "pass-arguments-to-command": [
      { "source": "string", "name": "/root/portfolio/deploy.sh" }
    ],
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "70fcde3687302670bccbc9ef7c8614d052d4fa5e",
            "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "refs/heads/main",
            "parameter": { "source": "payload", "name": "ref" }
          }
        }
      ]
    }
  }
]
